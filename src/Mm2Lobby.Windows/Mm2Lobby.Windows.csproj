<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The lobby launcher reads a COM vtable through a function pointer, and a
         function pointer needs unsafe code. The probe project carries the same
         setting for the same reason. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mm2Lobby.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mm2Lobby.Core\Mm2Lobby.Core.csproj" />
  </ItemGroup>

</Project>
